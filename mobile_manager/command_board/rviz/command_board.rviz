    Enabled: true
    Name: 地图资产
    Value: true
  - Class: rviz_common/Group
    Displays:
    - Class: cartographer_rviz/SubmapsDisplay
      Enabled: true
      Fade-out distance: 1
      High Resolution: true
      Low Resolution: false
      Name: LocSubmaps
      Submap query service: /localization/submap_query
      Submaps:
        All: true
        All Submap Pose Markers: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /localization/submap_list
      Tracking frame: map
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: LocTrajectories
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /localization/trajectory_node_list
      Value: false
    - Class: rviz_default_plugins/MarkerArray
