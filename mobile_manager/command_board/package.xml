<?xml version="1.0"?>
<package format="3">
  <name>command_board</name>
  <version>0.5.0</version>
  <description>导航系统管理</description>

  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>nav2_msgs</depend>
  <depend>std_srvs</depend>
  <depend>action_msgs</depend>
  <depend>nav_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>glog</depend>
  <depend>boost</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>sensor_msgs</depend>

  <!-- RViz2 状态显示面板依赖（可选；无 RViz 环境时 CMake QUIET 跳过） -->
  <depend>std_msgs</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>pluginlib</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/rviz_plugins/plugin_description.xml"/>
  </export>
</package>
