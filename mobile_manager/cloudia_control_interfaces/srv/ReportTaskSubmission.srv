uint8 ACCEPTED=0
uint8 REJECTED=1
uint8 UNCERTAIN=2
uint8 NOT_SENT=3

string request_id
# Returned by RequestTaskSubmission. May be empty only for NOT_SENT.
string coordinator_id
uint8 outcome
# Positive when ACCEPTED; 0 otherwise.
int64 task_id
string detail
---
# Reports are idempotent; retry the report, NEVER retry HTTP start.
bool recorded
string message
