<?xml version="1.0"?>
<package format="3">
  <name>map_manager</name>
  <version>0.5.0</version>
  <description>ROS2 port of map_manager (minimal ROS1->ROS2 changes; nav_interfaces used)</description>

  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>glog</depend>
  <depend>boost</depend>
  <depend>libopencv-dev</depend>
  <!-- 地图导入导出（zip 包、sha256、清单） -->
  <depend>libarchive-dev</depend>
  <depend>libssl-dev</depend>
  <depend>nlohmann-json-dev</depend>

  <!-- RViz2 插件依赖（可选；无 RViz 环境时 CMake QUIET 跳过） -->
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>pluginlib</depend>

  <exec_depend>python3</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/rviz_plugins/plugin_description.xml"/>
  </export>
</package>
