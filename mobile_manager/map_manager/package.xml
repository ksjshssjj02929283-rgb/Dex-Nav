<?xml version="1.0"?>
<package format="3">
  <name>map_manager</name>
  <version>0.4.5</version>
  <description>ROS2 port of map_manager (minimal ROS1->ROS2 changes; nav_interfaces used)</description>

  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>glog</depend>
  <depend>boost</depend>
  <!-- NodeMap RViz 编辑插件依赖；插件代码与 map_manager_node 独立。 -->
  <depend>nav2_map_server</depend>
  <depend>visualization_msgs</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>rviz_default_plugins</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/nodemap_rviz_plugin/plugin_description.xml"/>
  </export>
</package>
