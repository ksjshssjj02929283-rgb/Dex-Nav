# [ParkWheels] 全向舵轮驻车：四轮朝里 X 锁，轮速 0。
# Server: mobile_cmd_omni (/park_wheels)
# Client: BT 节点 ParkWheels（nav2_behavior_tree）

#goal definition
float32 steer_angle_rad
float32 timeout_sec
float32 settle_tolerance_rad
---
#result definition
builtin_interfaces/Duration total_elapsed_time
bool success
string message
---
#feedback definition
float32 max_steer_error
builtin_interfaces/Duration time_left
