<?xml version="1.0" ?>
<robot name="B1-AMR">

  <!-- footprint -->
  <link name="base_footprint"/>
  <!-- base_link_joint -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
    <axis xyz="0 0 0" />
  </joint>

  <!-- base_link -->
  <link name="base_link">
    <!-- 外观属性 -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.685 0.560 0.25"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
      </material>
    </visual>
    <!-- 物理碰撞属性 -->
    <collision>
      <geometry>
        <box size="0.685 0.560 0.25"/>
      </geometry>
    </collision>
    <!-- 质量和惯性 -->
    <inertial>
      <mass value="15"/>
      <inertia ixx="0.18125" ixy="0.0" ixz="0.0" iyy="0.40625" iyz="0.0" izz="0.53125"/>
    </inertial>
  </link>

  <link name="laser_front_link">
    <inertial>
      <origin xyz="-0.00163226605178779 -3.81046922211525E-05 -0.0109858757086851" rpy="0 0 0" />
      <mass value="0.0270845630745659" />
      <inertia ixx="9.26761139629486E-06" ixy="-8.15186724546099E-09" ixz="1.11929715299346E-08" iyy="9.24891699462467E-06" iyz="7.68768412175614E-10" izz="1.54092066975936E-05" />
    </inertial>
  </link>

  <joint name="laser_front_joint" type="fixed">
    <origin xyz="0.174973 0.145982 0.180056" rpy="0 0 0.7854" />
    <parent link="base_link" />
    <child link="laser_front_link" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="laser_rear_link">
    <inertial>
      <origin xyz="-0.00163226515919279 -3.81039738022448E-05 -0.0109858756959254" rpy="0 0 0" />
      <mass value="0.0270845630487793" />
      <inertia ixx="9.26761147077806E-06" ixy="-8.15116807715507E-09" ixz="1.11931999807769E-08" iyy="9.24891703100811E-06" iyz="7.6892758075562E-10" izz="1.5409206785005E-05" />
    </inertial>
  </link>

  <joint name="laser_rear_joint" type="fixed">
    <origin xyz="-0.174973 -0.145982 0.180056" rpy="0 0 -2.3562" />
    <parent link="base_link" />
    <child link="laser_rear_link" />
    <axis xyz="0 0 0" />
  </joint>
  
  <!-- RGB Camera Front -->
  <joint name="camera_front_joint" type="fixed">
    <origin xyz="0.302139 0.00758 0.140197" rpy="1.5717 0 -1.5717" /> 
    <parent link="base_link" />
    <child link="camera_front" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="camera_front">
      <inertial>
      <origin xyz="0.00759 -2.41924E-05 -0.000284" rpy="0 0 0" />
      <mass value="0.0221" />
      <inertia ixx="0.000193" ixy="-7.5735E-06" ixz="-6.98E-08" iyy="0.000123" iyz="1.1782E-07" izz="2.7401E-05" />
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0" /></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0" /></collision>
  </link> 

  <!-- Depth Camera Front -->
  <joint name="depth_front_joint" type="fixed">
    <origin xyz="0.0 -0.00758 0.0" rpy="0 0 0" />
    <parent link="camera_front" />
    <child link="depth_front" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="depth_front">
      <inertial>
      <origin xyz="-0.0121749689613144 -0.00166764283741135 1.11022302462516E-16" rpy="0 0 0" />
      <mass value="0.049943642470157" />
      <inertia ixx="3.03099978294819E-05" ixy="-6.18417155628911E-07" ixz="-5.0821976835258E-21" iyy="5.03370369341809E-06" iyz="-3.59872889703051E-21" izz="3.0368975272592E-05" />
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0" /></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0" /></collision>
  </link>

  <!-- RGB Camera Rear -->
  <joint name="camera_rear_joint" type="fixed">
    <origin xyz="-0.302139 -0.00758 0.140197" rpy="1.5717 0 -1.5717" /> 
    <parent link="base_link" />
    <child link="camera_rear" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="camera_rear">
      <inertial>
      <origin xyz="0.00759 -2.41924E-05 -0.000284" rpy="0 0 0" />
      <mass value="0.0221" />
      <inertia ixx="0.000193" ixy="-7.5735E-06" ixz="-6.98E-08" iyy="0.000123" iyz="1.1782E-07" izz="2.7401E-05" />
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0" /></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0" /></collision>
  </link> 

  <!-- Depth Camera Rear -->
  <joint name="depth_rear_joint" type="fixed">
    <origin xyz="0.0 -0.00758 0.0" rpy="0 0 0" />
    <parent link="camera_rear" />
    <child link="depth_rear" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="depth_rear">
      <inertial>
      <origin xyz="-0.0121749689613144 -0.00166764283741135 1.11022302462516E-16" rpy="0 0 0" />
      <mass value="0.049943642470157" />
      <inertia ixx="3.03099978294819E-05" ixy="-6.18417155628911E-07" ixz="-5.0821976835258E-21" iyy="5.03370369341809E-06" iyz="-3.59872889703051E-21" izz="3.0368975272592E-05" />
      </inertial>
      <visual><origin xyz="0 0 0" rpy="0 0 0" /></visual>
      <collision><origin xyz="0 0 0" rpy="0 0 0" /></collision>
  </link>

  <!-- imu_chassis_joint -->
  <joint name="imu_chassis_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.273 0 0.0"/>
    <parent link="base_link"/>
    <child link="imu_chassis_link"/>
    <axis xyz="0 0 0"/>
  </joint>
 
  <!-- imu_link -->
  <link name="imu_chassis_link">
    <visual>
      <geometry><cylinder length="0.1" radius="0.05"/></geometry>
      <material name="grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Left and Right Wheel links for diff drive plugin -->
  <link name="left_wheel_link">
    <visual>
      <geometry><cylinder length="0.05" radius="0.10"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder length="0.05" radius="0.10"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.3 -0.08" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <geometry><cylinder length="0.05" radius="0.10"/></geometry>
    </visual>
    <collision>
      <geometry><cylinder length="0.05" radius="0.10"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.3 -0.08" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ==================== FRONT LEFT CASTER ==================== -->
  <link name="caster_fl_swivel_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.03"/>
      </geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
  </link>
  <joint name="caster_fl_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_fl_swivel_link"/>
    <origin xyz="0.25 0.20 -0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.03" friction="0.003"/>
  </joint>

  <link name="caster_fl_wheel_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
  </link>
  <joint name="caster_fl_wheel_joint" type="continuous">
    <parent link="caster_fl_swivel_link"/>
    <child link="caster_fl_wheel_link"/>
    <origin xyz="-0.02 0 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.0005"/>
  </joint>

  <!-- ==================== FRONT RIGHT CASTER ==================== -->
  <link name="caster_fr_swivel_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="caster_fr_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_fr_swivel_link"/>
    <origin xyz="0.25 -0.20 -0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.03" friction="0.003"/>
  </joint>

  <link name="caster_fr_wheel_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
  </link>
  <joint name="caster_fr_wheel_joint" type="continuous">
    <parent link="caster_fr_swivel_link"/>
    <child link="caster_fr_wheel_link"/>
    <origin xyz="-0.02 0 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.0005"/>
  </joint>

  <!-- ==================== REAR LEFT CASTER ==================== -->
  <link name="caster_rl_swivel_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="caster_rl_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_rl_swivel_link"/>
    <origin xyz="-0.25 0.20 -0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.03" friction="0.003"/>
  </joint>

  <link name="caster_rl_wheel_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
  </link>
  <joint name="caster_rl_wheel_joint" type="continuous">
    <parent link="caster_rl_swivel_link"/>
    <child link="caster_rl_wheel_link"/>
    <origin xyz="-0.02 0 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.0005"/>
  </joint>

  <!-- ==================== REAR RIGHT CASTER ==================== -->
  <link name="caster_rr_swivel_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.03"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="caster_rr_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_rr_swivel_link"/>
    <origin xyz="-0.25 -0.20 -0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.03" friction="0.003"/>
  </joint>

  <link name="caster_rr_wheel_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
  </link>
  <joint name="caster_rr_wheel_joint" type="continuous">
    <parent link="caster_rr_swivel_link"/>
    <child link="caster_rr_wheel_link"/>
    <origin xyz="-0.02 0 -0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.005" friction="0.0005"/>
  </joint>

  <!-- Gazebo specific configurations -->
  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- Gazebo specific configurations for 4 Casters -->
  <gazebo reference="caster_fl_wheel_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="caster_fr_wheel_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="caster_rl_wheel_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="caster_rr_wheel_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="laser_front_link">
    <sensor name="laser_front" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.120000</min>
          <max>20.0</max>
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="laser_front_sensor" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan_front</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_front_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="laser_rear_link">
    <sensor name="laser_rear" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.120000</min>
          <max>20.0</max>
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="laser_rear_sensor" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan_rear</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_rear_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="imu_chassis_link">
    <sensor name="tb3_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="turtlebot3_imu" filename="libgazebo_ros_imu_sensor.so">
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <ros>
          <remapping>~/out:=imu</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.6</wheel_separation>
      <wheel_diameter>0.20</wheel_diameter>
      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <odometry_source>1</odometry_source>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
