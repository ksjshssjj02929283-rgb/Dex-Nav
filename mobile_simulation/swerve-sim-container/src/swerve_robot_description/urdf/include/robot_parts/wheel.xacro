<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wheel Link + Joint -->
  <xacro:macro name="wheel" params="locationprefix">

    <link name="${locationprefix}_wheel_link">
      <inertial>
        <origin xyz="-0.0016559 2.498E-05 -1.1185E-05" rpy="0 0 0" />
        <mass value="0.11363" />
        <inertia ixx="0.0049366" ixy="-9.2744E-07" ixz="2.0492E-07" iyy="0.002578" iyz="9.052E-08" izz="0.0025791" />
      </inertial>
      <!-- Visual intentionally omitted: the DexForce chassis mesh already shows
           wheels, so the functional swerve wheels are hidden. Collision is a
           simple cylinder sized to the real DexForce wheel (radius 0.0535 m,
           diam 107 mm) so the physical contact radius matches the kinematic
           wheel_radius used by the commander/odometer. Cylinder axis is rotated
           to lie along the wheel spin axis (Y). -->
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963267948966 0 0" />
        <geometry>
          <cylinder radius="0.0535" length="0.05" />
        </geometry>
      </collision>
    </link>

    <gazebo reference="${locationprefix}_wheel_link">
      <material>Gazebo/Black</material>
      <!-- Wheel-ground traction. Without explicit friction the cylinder spins in
           place; mu1 along roll, mu2 lateral. kp/kd are contact stiffness/damping
           and maxVel/minDepth tame contact jitter on the rolling cylinder. -->
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>

    <!-- Wheel center sits at z = wheel_radius (0.0535) above the chassis/base
         ground plane so the cylinder rests on the floor. -->
    <joint name="wheel_${locationprefix}_joint" type="continuous">
      <origin xyz="0.0 0.0 0.0535" rpy="0 0 0" />
      <parent link="${locationprefix}_steering_link" />
      <child link="${locationprefix}_wheel_link" />
      <axis xyz="0 1 0" />
      <limit effort="1.0" velocity="27" />
    </joint>

  </xacro:macro>

</robot>
