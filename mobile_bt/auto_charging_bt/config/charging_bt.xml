<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="AutoChargingRoot">
      <!-- 已经处于充电状态：本次回充直接成功，不再导航/对接 -->
      <IsCharging />

      <!-- 未充电：正常执行完整回充流程 -->
      <Sequence name="ChargingFlow">
        <!-- path_navigation 跳过前置导航；nav2 导航失败时向外返回 FAILURE。 -->
        <Fallback name="OptionalChargingPointNavigation">
          <Inverter>
            <IsChargingNavigationEnabled enabled="{navigate_to_charging}" />
          </Inverter>
          <RetryUntilSuccessful num_attempts="3">
            <Sequence name="NavigateAttempt">
              <AttemptLogger label="导航" counter_key="nav_attempt_count" total="3" />
              <NavigateToCharging goal="{charging_pose}" />
            </Sequence>
          </RetryUntilSuccessful>
        </Fallback>

        <!-- 导航成功后，回充对接单独最多尝试3次 -->
        <RetryUntilSuccessful num_attempts="3">
          <Sequence name="DockAttempt">
            <AttemptLogger label="回充对接" counter_key="dock_attempt_count" total="3" />
            <StartDetection />

            <!-- 二维码检测或视觉对接失败时仅停止检测，不执行退桩。 -->
            <Fallback name="DockOnly">
              <Dock timeout="{dock_timeout}" qr_detection_timeout="{qr_detection_timeout}" />
              <Sequence name="StopDetectionAfterDockFailure">
                <StopDetection />
                <AlwaysFailure />
              </Sequence>
            </Fallback>

            <!-- 只有完成对接后仍未确认充电，才退桩并重新尝试。 -->
            <Fallback name="VerifyCharging">
              <CheckCharging timeout="20.0" />
              <Sequence name="UndockAfterChargingFailure">
                <StopDetection />
                <Undocking duration="{undocking_duration}" />
                <AlwaysFailure />
              </Sequence>
            </Fallback>
          </Sequence>
        </RetryUntilSuccessful>

        <StopDetection />
      </Sequence>
    </Fallback>
  </BehaviorTree>
</root>
