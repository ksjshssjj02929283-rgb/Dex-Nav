<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="Root">
      <NavigateToCharging goal="{charging_pose}" />
      <StartDetection />
      
      <!-- 统一3次尝试的控制循环 -->
      <RetryUntilSuccessful num_attempts="3">
        <Sequence name="DockAttemptCycle">
          <!-- 使用Fallback确保Dock失败时也能执行回退逻辑 -->
          <Fallback name="DockAndVerify">
            <!-- 尝试Dock并验证充电 -->
            <Sequence name="DockThenCheck">
              <Dock timeout="60.0"/>
              <CheckCharging timeout="20.0" />
            </Sequence>

            <!-- Dock失败或CheckCharging失败时，执行回退并重新导航 -->
            <Sequence name="RecoverAndRetry">
              <Undocking duration="2.0"/>
              <NavigateToCharging goal="{charging_pose}" />
              <AlwaysFailure /> <!-- 强制返回FAILURE触发重试 -->
            </Sequence>
          </Fallback>
        </Sequence>
      </RetryUntilSuccessful>
      <StopDetection />
    </Sequence>
  </BehaviorTree>
</root>
