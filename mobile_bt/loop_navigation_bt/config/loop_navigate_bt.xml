<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <!-- ReactiveSequence 每个 tick 都先执行电量分支，因此导航途中也能响应低电量。 -->
    <ReactiveSequence name="MainLoop">

      <!-- threshold=0 只用于等待首条有效电量；无数据时不允许误启动导航或回充。 -->
      <WaitForBatteryAboveThreshold threshold="0"/>

      <!-- Fallback 在充电子树 RUNNING 时会保持当前子节点，不会因电量重新超过低阈值而提前跳回导航。 -->
      <Fallback name="BatteryCheckAndCharging">
        <CheckBatteryAboveThreshold threshold="{low_battery_threshold}"/>

        <Sequence name="ChargingSequence">
          <!-- 先取消当前 Nav2 目标，再由 /auto_charging 接管机器人。 -->
          <CancelNavigation/>
          <CallCharging/>

          <!-- 电量未达到恢复阈值时返回 RUNNING，避免 Retry 无限同步重试造成忙循环。 -->
          <WaitForBatteryAboveThreshold threshold="{resume_battery_threshold}"/>

          <!-- 退桩完成时清除暂停标志，下一次 tick 恢复循环导航。 -->
          <Undocking duration="{undocking_duration}" linear_speed="{undocking_linear_speed}"/>
        </Sequence>
      </Fallback>

      <!-- 电量正常或完整回充退桩结束后，继续按 JSON 点位循环导航。 -->
      <LoopNavigateFourPoints points="{navigation_points}"/>

    </ReactiveSequence>
  </BehaviorTree>
</root>
