<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <!-- 这是全局的大循环；ReactiveSequence 每 tick 从头执行，
         但不会导致 ActionNode 重发 goal（前提是 ActionNode 正确实现）
    -->
    <ReactiveSequence name="MainLoop">

      <!-- ① 导航四个点位（循环） -->
      <!--   Loop 节点内部应该按 tick 驱动，不重复发 goal -->
      <LoopNavigateFourPoints points="{navigation_points}"/>

      <!-- ② 电量检查与停止流程 -->
      <Fallback name="BatteryCheck">

        <!-- 电量检查默认关闭；启用后低于 YAML 阈值会进入返回首点流程。 -->
        <CheckBatteryAboveThreshold threshold="{low_battery_threshold}" enabled="{check_battery}"/>

        <!-- 电量低于 YAML 阈值时进入停止流程。 -->
        <Sequence name="StopSequence">

          <!-- (a) 首先 cancel 当前导航 -->
          <CancelNavigation/>

          <!-- (b) 导航到第一个点并设置停止标志 -->
          <NavigateToFirstPointAndStop points="{navigation_points}"/>

        </Sequence>
      </Fallback>

    </ReactiveSequence>
  </BehaviorTree>
</root>
