<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
        schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>path_follower</name>
    <version>1.0.0</version>
    <description>
        PID path follower for omni-directional (and differential-drive) AGVs.
        Subscribes to an oriented path (nav_msgs/Path), follows it with a
        10-level gain-scheduled incremental PID and a trapezoidal/S-curve velocity
        planner, and publishes geometry_msgs/Twist on cmd_vel.
    </description>
    <maintainer email="dev@example.com">path_follower</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>rclcpp_action</depend>
    <depend>rclcpp_components</depend>
    <depend>nav_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>tf2</depend>
    <depend>tf2_ros</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>angles</depend>
    <depend>nav_interfaces</depend>
    <depend>std_srvs</depend>
    <depend>ruckig</depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
