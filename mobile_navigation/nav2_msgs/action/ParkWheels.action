# 全向/舵轮底盘驻车：四轮朝里形成 X 锁，驱动速度为 0。
# 由 mobile_cmd_omni 提供 /park_wheels Action Server；BT 节点 ParkWheels 调用。

#goal definition
# 朝里舵角幅值（rad），常用 45deg ≈ 0.785；符号由 Server 按轮位分配成 X 形
float32 steer_angle_rad
# 等待舵角到位的最长时间（秒）
float32 timeout_sec
# 四轮相对目标舵角的最大允许误差（rad），全部小于此值则成功
float32 settle_tolerance_rad
---
#result definition
builtin_interfaces/Duration total_elapsed_time
bool success
string message
---
#feedback definition
float32 max_steer_error
builtin_interfaces/Duration time_left
