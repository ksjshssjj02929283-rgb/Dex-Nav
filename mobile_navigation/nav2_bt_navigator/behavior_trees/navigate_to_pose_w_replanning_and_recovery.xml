<!--
  This Behavior Tree replans the global path periodically while following it.

  Global planning recovery:
  - If ComputePathToPose fails, try clearing both the global and local costmaps.
  - Both costmap clearing actions are treated as auxiliary recovery actions.
  - Even if either clearing action fails, the tree still retries ComputePathToPose.
  - If the inner retry still fails, wait, try clearing both costmaps again,
    and then enter the next planning retry loop.
  - Before waiting on a repeated global planning failure, cancel the active
    FollowPath goal so the robot stops instead of continuing to push along an
    old path that is no longer globally connectable.
  - The outer retry count is intentionally large so temporary dynamic obstacles
    do not make the whole navigation action fail before a later replan succeeds.

  Local control recovery:
  - If FollowPath fails, try clearing the local costmap.
  - Even if clearing fails, the tree still retries FollowPath immediately.
  - If the inner retry still fails, wait 1 second, clear the local costmap,
    back up 0.30 m, and then retry local control.
  - BackUp is treated as an optional recovery action: if backing up is blocked
    or out of the local costmap, navigation keeps waiting/retrying instead of
    failing the whole goal.
  - Unlike the outer global-planning retry, this loop is bounded: an unbounded
    local recovery loop can spin indefinitely on a position the robot cannot
    escape, with no signal to the caller that anything is wrong. A bounded
    count still gives many chances for transient obstacles to clear, but
    eventually fails the goal so the caller (and any operator watching it)
    finds out instead of waiting forever.
-->

<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">

      <!-- 全局规划：每 3 秒重规划一次 -->
      <RateController hz="0.02">
        <RecoveryNode number_of_retries="9999" name="ComputePathToPoseOuterRetry">

          <!-- 内层：规划失败后，依次尝试清 global 和 local，然后立即重规划 1 次 -->
          <RecoveryNode number_of_retries="1" name="ComputePathToPoseInnerRetry">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="SmacGridBased"/>

            <Sequence name="ClearBothCostmaps-FirstRetry">
              <ForceSuccess>
                <ClearEntireCostmap name="ClearGlobalCostmap-FirstRetry"
                  service_name="global_costmap/clear_entirely_global_costmap"/>
              </ForceSuccess>

              <ForceSuccess>
                <ClearEntireCostmap name="ClearLocalCostmap-FirstPlanningRetry"
                  service_name="local_costmap/clear_entirely_local_costmap"/>
              </ForceSuccess>
            </Sequence>
          </RecoveryNode>

          <!-- 外层：如果内层仍失败，等待后依次尝试清 global 和 local，然后进入下一轮 -->
          <Sequence name="WaitClearBothCostmapsAndRetry">
            <ForceSuccess>
              <CancelControl name="CancelFollowPathOnRepeatedGlobalPlanFailure"/>
            </ForceSuccess>

            <Wait wait_duration="1" server_name="wait_global"/>

            <ForceSuccess>
              <ClearEntireCostmap name="ClearGlobalCostmap-OuterRetry"
                service_name="global_costmap/clear_entirely_global_costmap"/>
            </ForceSuccess>

            <ForceSuccess>
              <ClearEntireCostmap name="ClearLocalCostmap-OuterPlanningRetry"
                service_name="local_costmap/clear_entirely_local_costmap"/>
            </ForceSuccess>
          </Sequence>

        </RecoveryNode>
      </RateController>


      <!-- 局部控制 -->
      <RecoveryNode number_of_retries="9999" name="FollowPathAfterBackUpRetry">

        <!-- 内层：FollowPath 失败后，尝试清 local，然后立即 FollowPath 1 次 -->
        <RecoveryNode number_of_retries="1" name="FollowPathInnerRetry">
          <FollowPath path="{path}" controller_id="MPPIController"/>

          <ForceSuccess>
            <ClearEntireCostmap name="ClearLocalCostmap-FirstRetry"
              service_name="local_costmap/clear_entirely_local_costmap"/>
          </ForceSuccess>
        </RecoveryNode>

        <!-- 如果立即重试仍失败，则等待 1 秒、清 local、后退，然后继续重试局部控制 -->
        <Sequence name="WaitClearBackUpAfterFollowPathFailed">
          <Wait wait_duration="1" server_name="wait_local"/>

          <ForceSuccess>
            <ClearEntireCostmap name="ClearLocalCostmap-BeforeBackUp"
              service_name="local_costmap/clear_entirely_local_costmap"/>
          </ForceSuccess>
          <ForceSuccess>
            <!-- <Wait wait_duration="1" server_name="wait_local"/> -->
            <BackUp name="BackUpAfterLocalRetries" backup_dist="0.30" backup_speed="0.08" time_allowance="5"/>
          </ForceSuccess>
        </Sequence>

      </RecoveryNode>

    </PipelineSequence>
  </BehaviorTree>
</root>
