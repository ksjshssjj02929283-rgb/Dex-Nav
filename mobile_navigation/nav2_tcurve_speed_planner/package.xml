<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_tcurve_speed_planner</name>
  <version>0.1.0</version>
  <description>
    T 型曲线速度规划器（nav2_core::SpeedPlanner 实现）。
    由 dcm tcurve_speed_planner 移植：三段式（加速/匀速/减速）+ 曲率/障碍约束，
    把局部几何 Path 升级为带速度的 RobotTrajectory（五层架构 ④速度规划层）。
  </description>
  <maintainer email="dexforce@dexforce.com">dexforce</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_common</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>nav_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/nav2_tcurve_speed_planner.xml" />
  </export>
</package>
