<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_pure_rotation_controller</name>
  <version>0.5.0</version>
  <description>
    原地旋转控制器（nav2_core::Controller pluginlib 插件）。纵向 station/speed PID
    + 独立角速度 PID 并行；enable_lon_adjust 控制是否纯旋转（false = 只转）。
  </description>
  <maintainer email="dexforce@dexforce.com">dexforce</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_common</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>nav_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>nav2_controller_common</depend>

  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/nav2_pure_rotation_controller.xml" />
  </export>
</package>
