<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_route_planner</name>
  <version>0.1.0</version>
  <description>
    Nav2 GlobalPlanner plugin that plans on a road-graph (NavPoints + Junctions + Edges)
    served by map_asset_manager. Outputs nav_msgs/Path for controllers and a parallel
    nav_interfaces/RoutePlan topic with per-segment semantics (max_speed, lane_subtype,
    regulatory_element refs, floor) for downstream RuntimeBinder / Behavior Tree.
  </description>
  <maintainer email="robot@dexforce.com">DEXE Robot Engineer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_action</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav2_common</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>nav_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/nav2_route_planner.xml" />
  </export>
</package>
