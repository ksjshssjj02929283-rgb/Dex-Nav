    </class>
  </library>
  <library path="docking_exit">
    <class type="docking_base_plugins::DockingExit" base_class_type="docking_base_core::DockingInterface">
      <description>出桩对接任务：前进离桩单段（DEC-011 Part2）。</description>
    </class>
  </library>
  <library path="straight_line_planner">
    <class type="docking_base_plugins::StraightLinePlanner" base_class_type="docking_base_core::DockingPlanner">
      <description>直线对接局部规划：段路径重采样（线性插值+slerp）+ 梯形纵向速度剖面（倒车取负），出 RobotTrajectory，不避障。</description>
    </class>
  </library>
