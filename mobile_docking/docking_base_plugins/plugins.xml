<class_libraries>
  <library path="apriltag_perception">
    <class type="docking_base_plugins::AprilTagPerception" base_class_type="docking_base_core::PerceptionInterface">
      <description>
        AprilTag 对接感知：封装 start/stop_apriltag_detection 服务 + apriltag_target_pose 订阅，
        提供 start/stop/getDockPose（DEC-011 Part1，感知与对接逻辑解耦）。
      </description>
    </class>
  </library>
  <library path="docking_charging">
    <class type="docking_base_plugins::DockingCharging" base_class_type="docking_base_core::DockingInterface">
