%package command_board
%start Localization_SM_Map::INITIAL
%class Localization_SM
%header localization_sm.h
%map Localization_SM_Map
%%
// State		Transition		End State		Action(s)
INITIAL 
{
				LocalizationFailed		LOC_FAILED			{OnLocalizationFailed();}
				LocalizationSuccess		LOC_SUCCESS			{OnLocalizationSuccess();}
}

LOC_FAILED
{
				LocalizationFailed		LOC_FAILED			{OnLocalizationFailed();}
				LocalizationSuccess		LOC_SUCCESS			{OnLocalizationSuccess();}
}

LOC_SUCCESS
{
				LocalizationSuccess		LOC_SUCCESS			{}
				LocalizationFailed		LOC_FAILED			{OnLocalizationFailed();}
}

%%
